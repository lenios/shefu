<script id="bedrock-schema_1-0" class="comp bedrock-schema mntl-schema-unified" type="application/ld+json">[
{
"@context": "http://schema.org",
"@type": ["Recipe"]
,"headline": "Thick and Fluffy Pancakes From Homemade Pancake Mix Recipe"
,"datePublished": "2019-03-22T08:57:18-04:00"
,"dateModified": "2025-03-19T16:08:45-04:00"
,"author": [
{"@type": "Person"
,"name": "Stella Parks"
,"url": "https://www.seriouseats.com/stella-parks-5119004"
}
]
,"description": "Thick pancakes that are fluffy, not dense, with a tender, pillowy soft crumb. Much like Japanese pancakes, these cook up extra thick and light."
,"image": {
"@type": "ImageObject",
"url": "https://www.seriouseats.com/thmb/csFkifo3TJg4Ryb4NyMdq-qh9eU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/__opt__aboutcom__coeus__resources__content_migration__serious_eats__seriouseats.com__2019__03__20190129-pancakes-vicky-wasik-27-1d6ec83141264d41a2af7a4b35a0c1d4.jpg",
"height": 1125,
"width": 1500
}
,"video": {
"@type": "VideoObject",
"contentUrl": "https://content.jwplatform.com/videos/GDgubzVU-YWmivM3Y.mp4",
"description": "This homemade pancake mix can sit on the shelf for months on end. When you're ready for breakfast, just add milk and an egg—no whipping required! [Video: Serious Eats Team, Technique: Stella Parks]",
"duration": "PT7M1S",
"name": "How to Make Easy, Shelf-Stable Pancake Mix",
"thumbnailUrl": "https://cdn.jwplayer.com/v2/media/GDgubzVU/poster.jpg?width=1280",
"uploadDate": "2021-04-26T12:59:28-04:00"}
,"publisher": {
"@type": "Organization",
"name": "Serious Eats",
"url": "https://www.seriouseats.com",
"logo": {
"@type": "ImageObject",
"url": "https://www.seriouseats.com/thmb/tCg_KKb2J_OIG_QEUtCkqjhiJGQ=/2339x320/filters:no_upscale():max_bytes(150000):strip_icc()/Serious_Eats_Schema_Logo-30a63d9c07734d35836c8ff2d368419c.png",
"width": 2339,
"height": 320
},
"brand": "Serious Eats"
, "publishingPrinciples": "https://www.seriouseats.com/about-us-5120006#toc-editorial-guidelines"
, "sameAs" : [
"https://www.instagram.com/seriouseats",
"https://www.facebook.com/seriouseats",
"https://www.pinterest.com/seriouseats",
"https://www.youtube.com/user/seriouseats"
]
}
,"name": "Thick and Fluffy Pancakes From Homemade Pancake Mix Recipe"
,"aggregateRating": {
"@type": "AggregateRating",
"ratingValue": "4.7",
"ratingCount": "13"
}
,"cookTime": "PT5M"
,"keywords": "baking, breakfast, brunch, coconut oil, food processor, griddle, malted milk powder"
,"nutrition": {
"@type": "NutritionInformation"
,"calories": "167 kcal"
,"carbohydrateContent": "16 g"
,"cholesterolContent": "24 mg"
,"fiberContent": "1 g"
,"proteinContent": "3 g"
,"saturatedFatContent": "8 g"
,"sodiumContent": "247 mg"
,"sugarContent": "4 g"
,"fatContent": "10 g"
,"servingSize": "makes eight 4 1/2-inch pancakes"
,"unsaturatedFatContent": "0 g"
}
,"prepTime": "PT5M"
, "recipeCategory": ["Breakfast","Brunch","Breakfast Sweets","Pancake","Quick and Easy","Quick Bread"]
,"recipeCuisine": ["American"]
,"recipeIngredient": [
"4 1/2 ounces all-purpose flour, such as Gold Medal blue label (about 1 cup, spooned; 125g)",
"1/2 ounce sugar (about 1 tablespoon; 15g)",
"1/2 ounce malted milk powder, such as Carnation or Hoosier Hill Farms (about 2 tablespoons; 15g)",
"1 1/2 teaspoons (6.8g) baking powder",
"1/2 teaspoon (2g) Diamond Crystal kosher salt; for table salt, use about half as much by volume or the same weight",
"1/4 teaspoon (1.6g) baking soda",
"2 1/2 ounces refined coconut oil, solid and firm, between 68°F and 72°F (about 1/3 cup; 70g)",
"4 ounces milk, any percentage will do , or non-dairy alternatives (about 1/2 cup; 115g)",
"1 large egg, straight from the fridge (1 3/4 ounces; 50g)",
"1/4 ounce vanilla extract (about 1 1/2 teaspoons ; 7g)",
"1 batch pancake mix, above (about 1 1/2 cups; 8 1/4 ounces; 233g)" ]
,"recipeInstructions": [
{
"@type": "HowToStep"
,"image": [
{
"@type": "ImageObject",
"url": "https://www.seriouseats.com/thmb/wvEgsuqF-nKe_wiXtjWTSQbVZeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/__opt__aboutcom__coeus__resources__content_migration__serious_eats__seriouseats.com__2019__03__20190129-pancakes-vicky-wasik-processor-before-after-2cbc6ce4e74a4f18b191ad4a99825fa4.jpg"
}
]
,"text": "For the Pancake Mix: In the bowl of a food processor, combine flour, sugar, malted milk powder, baking powder, salt, and baking soda. Process about 30 seconds to ensure the leavening agents are fully homogenized into flour."
} ,{
"@type": "HowToStep"
,"image": [
{
"@type": "ImageObject",
"url": "https://www.seriouseats.com/thmb/Yefw8Bu77Yxe4d6tGKbsPIQ8C50=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/__opt__aboutcom__coeus__resources__content_migration__serious_eats__seriouseats.com__2019__03__20190129-pancakes-vicky-wasik-mix-before-after-f0835bbe80ed458184933bf1bf7ae113.jpg"
}
]
,"text": "Add solid coconut oil and pulse only until it disappears into a dry and powdery mix, just a few seconds. It&#39;s important that the coconut oil is fully combined into the flour, while also remaining powdery and dry, so use caution and avoid over-processing, especially with larger batches. At this point, you can either continue with the recipe or transfer the mix to an airtight container and store up to one year at or below 74°F (24°C), or until the date stamped on the package of coconut oil."
} ,{
"@type": "HowToStep"
,"image": [
{
"@type": "ImageObject",
"url": "https://www.seriouseats.com/thmb/hEtjK48XkahDFNKTvKHAj9ivAWY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/__opt__aboutcom__coeus__resources__content_migration__serious_eats__seriouseats.com__2019__03__20190129-pancakes-vicky-wasik-adding-wet-ingredients-9577841220a942898914a0e613f6e06c.jpg"
}
]
,"text": "For the Pancakes: Preheat an electric griddle to 350°F (177°C), or heat a large, nonstick skillet to a similar temperature on the stovetop. In a large mixing bowl, whisk milk, egg, and vanilla extract until well combined. Add the prepared pancake mix, and whisk until relatively smooth, although a few flecks of coconut oil may dot the batter."
} ,{
"@type": "HowToStep"
,"image": [
{
"@type": "ImageObject",
"url": "https://www.seriouseats.com/thmb/csFkifo3TJg4Ryb4NyMdq-qh9eU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/__opt__aboutcom__coeus__resources__content_migration__serious_eats__seriouseats.com__2019__03__20190129-pancakes-vicky-wasik-27-1d6ec83141264d41a2af7a4b35a0c1d4.jpg"
}
]
,"text": "With a large scoop, measuring cup, or piping bag, divide batter in 1/3-cup portions (or as desired), and griddle until golden brown on either side, and cooked through the middle, about 90 seconds per side. Serve immediately, with butter, maple syrup, fresh fruit, whipped cream, or whatever other toppings sound fun."
} ,{
"@type": "HowToStep"
,"text": "Troubleshooting: The timing and yield of this recipe will vary substantially depending on how the pancake batter is portioned as well as the exact temperature of the griddle itself. When pancakes are excessively browned but raw in the middle, the griddle is likely too hot; when the pancakes are cooked through but too soft and pale, the griddle may be too cool."
} ]
,"recipeYield": "8"
,"totalTime": "PT10M"
,"review": [
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "jnachtigal"
},
"reviewBody": "I just got a big propane griddle so what better to do for a Sunday breakfast than pancakes.I only had virgin coconut oil on hand so they did have a faint coconut flavor, but still fantastic. A nice golden slightly crisp exterior with a fluffy interior.This has become the new go to pancake recipe for the family.",
"datePublished": "2020-04-05T16:58:19.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "zombie127"
},
"reviewBody": "Hello. Hmm, do you have any recommendations for using whole wheat flour? Maybe not all of it, I am used to making my pancakes with it and I think I'd miss the flavor.",
"datePublished": "2019-04-23T15:59:53.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "MaryJo"
},
"reviewBody": "Hey Stella, these look and sound great! To accomodate vegan members of the family, can I use a flax or chia \"egg\" mixture, instead of a regular egg?",
"datePublished": "2019-03-25T20:47:13.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "Serious Eats Member"
},
"reviewBody": "Can I substitute Crisco for coconut oil?",
"datePublished": "2025-03-03T16:12:45.000Z"
}
,
{
"@type": "Review",
"reviewRating": {
"@type": "Rating",
"ratingValue": "3"
},
"author": {
"@type": "Person",
"name": "Benjamin Billick"
},
"reviewBody": "This makes some very tasty, fluffy pancakes, but it DEFINITELY does not make 8 servings. I'd add at minimum an additional 50%.",
"datePublished": "2024-09-01T13:32:55.000Z"
}
,
{
"@type": "Review",
"reviewRating": {
"@type": "Rating",
"ratingValue": "5"
},
"author": {
"@type": "Person",
"name": "Jered"
},
"reviewBody": "This remains my go-to pancake receipe for the past several years; they are fluffy but still have a delightfully cake-like crumb!My only comment is that with a #12 scoop I only get 4 (good-sized) pancakes from one batch, not 8. This is so consistent it feels like a scaling error, and means that I always pre-make 12 \"batches\" when doing my periodic prep.These pancakes also freeze exceedingly well, and hold drop-ins (chocolate chips, blueberries, banana slices) easily.",
"datePublished": "2024-01-14T16:31:44.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "Rachel Ekblad"
},
"reviewBody": "Another winner, Stella! SO GOOD. The malted milk powder really sets it off.",
"datePublished": "2023-02-25T14:45:23.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "Rex Lafferty"
},
"reviewBody": "This is the best recipe I've tried in the last few years for the following three reasons: 1) It totally works. The pancakes tasted great and are genuinely among the lightest and fluffiest I've ever eaten - as advertised. 2) The recipe is super simple, and made even easier by the fact that you can combine the dry ingredients and oil in advance, well in advance. 3) The recipe is completely unexpected. I'd never have imagined using coconut oil in pancakes, but it winds up making complete sense. I'm averse to all forms of coconut flavors, but refined coconut oil lacks all coconut taste and turns out to be a perfect vehicle for the dry ingredients in these pancakes. Kudos to Stella Parks!",
"datePublished": "2023-01-25T20:15:19.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "rp17"
},
"reviewBody": "Why the cold egg? Also, should the milk be cold or room temperature? Most things I've read say you should use room temp eggs and milk for pancakes.",
"datePublished": "2023-01-24T21:44:53.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "Hadmo"
},
"reviewBody": "I've made this recipe and the similar one from America's Test Kitchen, many times. I am lazy and I don't like to wash things so I just use a knife or pastry cutter chop/ cut the coconut oil into the pancake mix and then finish it with my hands. Itt works perfectly the consistency is great. I sometimes add a little more milk though because I don't like how thick these get but hey they say thick and fluffy and they are!",
"datePublished": "2021-03-27T12:34:14.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "atm"
},
"reviewBody": "Love this recipe! Any thoughts on how it could be adapted to make corn cakes? Maybe swap out 50% of the flour for yellow cornmeal?Thanks a lot,Aaron",
"datePublished": "2021-03-18T16:23:08.000Z"
}
,
{
"@type": "Review",
"author": {
"@type": "Person",
"name": "gb3"
},
"reviewBody": "If you do happen to over-process the coconut oil in the food processer, is there a way to fix it? Could you cool it in the fridge and re-run it in the food processor? Guessing not but trying to see if there's a way to salvage it.",
"datePublished": "2020-11-22T02:54:09.000Z"
}
]
,"mainEntityOfPage": {
"@type": ["WebPage"]
,"@id": "https://www.seriouseats.com/thick-and-fluffy-pancakes"
,"name": "Thick and Fluffy Pancakes From Homemade Pancake Mix Recipe"
