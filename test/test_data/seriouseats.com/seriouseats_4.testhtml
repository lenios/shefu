const cname = 'forms.seriouseats.com';
const type = 'delayed';
const fastActivation = 'true';
const timerDelay = parseFloat('1') * 1000 || 0;
const loadImmediate = false;
if (!brandId) return;
let lightboxPath = '';
let lightboxJs = fastActivation === 'true' ? 'lightbox_speed.js' : 'lightbox_inline.js';
