delayed() {
function loadDigioh() {
if (!Mntl.digioh.initialized) {
Mntl.digioh.types.load();
// Custom event to prevent circular dependencies on the timers.
// Kept inside the initialized guard so a repeat loadDigioh() call
// (e.g. the immediate arm's !isLoading() load followed by a synchronous
// onConsentChange fire) does not dispatch 'digiohLoaded' twice.
window.dispatchEvent(new CustomEvent('digiohLoaded'));
}
}
// Immediate arm: skip the ad-gated readyForDeferredScripts but STILL gate on CMP consent
if (Mntl.digioh.loadImmediate) {
