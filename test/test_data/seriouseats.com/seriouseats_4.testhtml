if (!CMP) {
loadDigioh();
return;
}
// CMP is present and has already resolved a decision (e.g. a US/non-opt-in region,
// or a warm OneTrust cache) - load immediately
if (!CMP.isLoading()) {
loadDigioh();
}
// Subscribe to CMP consent changes and load Digioh when the decision is published
CMP.onConsentChange(loadDigioh, true); // once = true
return;
}
window.addEventListener('readyForDeferredScripts', () => {
