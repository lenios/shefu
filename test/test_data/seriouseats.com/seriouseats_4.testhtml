<article id="bedrock-article_1-0" class="comp bedrock-article mntl-article sc-ad-container mntl-article--two-column-right-rail adjusted-right-rail" data-content-graph-id="none" data-tracking-container="true"><div class="loc article-post-header"><div id="article-header--recipe_1-0" class="comp article-header--recipe mm-recipes-article-header mntl-article-header">
<h1 class="article-heading text-headline-400">Thick and Fluffy Pancakes From Homemade Pancake Mix Recipe</h1>
<div id="mm-recipes-review-bar_1-0" class="comp mm-recipes-review-bar mntl-block has-ratings has-comments read-only js-recipe-review-bar"><div id="mm-recipes-review-bar__star-rating_1-0" class="comp mm-recipes-review-bar__star-rating mntl-recipe-star-rating mm-recipes-star-rating" data-click-tracked="true" data-tracking-subtype="Top Nav - Jump to Reviews - Rating" data-track-rating-location="Top Nav - Jump to Reviews - Stars" data-tracking-subcategory="Review Bar" data-tracking-container="true" data-tracking-category="User Recipe Action">
<svg class="icon icon-star "
>
<use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-star" href="#icon-star"></use>
</svg>
