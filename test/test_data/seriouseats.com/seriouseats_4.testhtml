data-srcset="https://www.seriouseats.com/thmb/524L35opWL0IcTCkbtRIu_MrPYA=/750x0/filters:no_upscale():max_bytes(150000):strip_icc()/__opt__aboutcom__coeus__resources__content_migration__serious_eats__seriouseats.com__2019__03__20190129-pancakes-vicky-wasik-mix-before-after-f0835bbe80ed458184933bf1bf7ae113.jpg 750w"
