data-srcset="https://www.seriouseats.com/thmb/fNQlFsBMpcdoc4VMmSsI8vGYuj8=/750x0/filters:no_upscale():max_bytes(150000):strip_icc()/__opt__aboutcom__coeus__resources__content_migration__serious_eats__seriouseats.com__2019__03__20190129-pancakes-vicky-wasik-27-1d6ec83141264d41a2af7a4b35a0c1d4.jpg 750w"
