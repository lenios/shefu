  "fixed_sql": [
    {
      "name": "recipes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"image_path\" TEXT NOT NULL, \"notes\" TEXT NOT NULL, \"servings\" INTEGER NOT NULL, \"pieces_per_serving\" INTEGER NULL, \"category\" INTEGER NOT NULL, \"country_code\" TEXT NOT NULL, \"calories\" INTEGER NOT NULL, \"fat\" INTEGER NOT NULL, \"carbohydrates\" INTEGER NOT NULL, \"protein\" INTEGER NOT NULL, \"saturated_fat\" INTEGER NOT NULL, \"trans_fat\" INTEGER NOT NULL, \"sugar\" INTEGER NOT NULL, \"fiber\" INTEGER NOT NULL, \"cholesterol\" INTEGER NOT NULL, \"sodium\" INTEGER NOT NULL, \"time\" INTEGER NOT NULL, \"cook_time\" INTEGER NOT NULL, \"prep_time\" INTEGER NOT NULL, \"rest_time\" INTEGER NOT NULL, \"month\" INTEGER NOT NULL, \"make_ahead\" TEXT NOT NULL, \"video_url\" TEXT NOT NULL, \"questions\" TEXT NOT NULL, \"language_tag\" TEXT NOT NULL, \"favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"favorite\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "recipe_variants",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_variants\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"recipe_id\" INTEGER NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "recipe_steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_steps\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"recipe_id\" INTEGER NULL REFERENCES recipes (id) ON DELETE CASCADE, \"variant_id\" INTEGER NULL REFERENCES recipe_variants (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"instruction\" TEXT NOT NULL, \"image_path\" TEXT NOT NULL, \"video_url\" TEXT NOT NULL, \"timer\" INTEGER NOT NULL, \"step_order\" INTEGER NOT NULL, CHECK ((recipe_id IS NULL) <> (variant_id IS NULL)));"
        }
      ]
    },
    {
      "name": "ingredient_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ingredient_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"step_id\" INTEGER NOT NULL REFERENCES recipe_steps (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"lower_name\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"quantity\" REAL NOT NULL, \"shape\" TEXT NOT NULL, \"food_id\" INTEGER NOT NULL, \"conversion_id\" INTEGER NOT NULL, \"optional\" INTEGER NOT NULL CHECK (\"optional\" IN (0, 1)), \"original_measure\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "nutrients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nutrients\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"food_id\" INTEGER NOT NULL UNIQUE, \"desc_en\" TEXT NOT NULL, \"desc_fr\" TEXT NOT NULL, \"protein\" REAL NOT NULL, \"water\" REAL NOT NULL, \"lipid_total\" REAL NOT NULL, \"energ_kcal\" REAL NOT NULL, \"carbohydrates\" REAL NOT NULL, \"ash\" REAL NOT NULL, \"fiber\" REAL NOT NULL, \"sugar\" REAL NOT NULL, \"calcium\" REAL NOT NULL, \"iron\" REAL NOT NULL, \"magnesium\" REAL NOT NULL, \"phosphorus\" REAL NOT NULL, \"potassium\" REAL NOT NULL, \"sodium\" REAL NOT NULL, \"zinc\" REAL NOT NULL, \"copper\" REAL NOT NULL, \"manganese\" REAL NOT NULL, \"selenium\" REAL NOT NULL, \"vitamin_c\" REAL NOT NULL, \"thiamin\" REAL NOT NULL, \"riboflavin\" REAL NOT NULL, \"niacin\" REAL NOT NULL, \"panto_acid\" REAL NOT NULL, \"vitamin_b6\" REAL NOT NULL, \"folate_total\" REAL NOT NULL, \"folic_acid\" REAL NOT NULL, \"food_folate\" REAL NOT NULL, \"folate_dfe\" REAL NOT NULL, \"choline_total\" REAL NOT NULL, \"vitamin_b12\" REAL NOT NULL, \"vitamin_a_iu\" REAL NOT NULL, \"vitamin_a_rae\" REAL NOT NULL, \"retinol\" REAL NOT NULL, \"alpha_carot\" REAL NOT NULL, \"beta_carot\" REAL NOT NULL, \"beta_crypt\" REAL NOT NULL, \"lycopene\" REAL NOT NULL, \"lut_zea\" REAL NOT NULL, \"vitamin_e\" REAL NOT NULL, \"vitamin_d\" REAL NOT NULL, \"vitamin_d_iu\" REAL NOT NULL, \"vitamin_k\" REAL NOT NULL, \"fa_sat\" REAL NOT NULL, \"fa_mono\" REAL NOT NULL, \"fa_poly\" REAL NOT NULL, \"cholesterol\" REAL NOT NULL);"
        }
      ]
    },
    {
      "name": "conversions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"conversions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"food_id\" INTEGER NOT NULL, \"measure_id\" INTEGER NOT NULL, \"desc_en\" TEXT NOT NULL, \"desc_fr\" TEXT NOT NULL, \"factor\" REAL NOT NULL);"
        }
      ]
    },
    {
      "name": "metadata",
